# AI Opportunity Agent — الإعدادات
# انسخ هذا الملف إلى ".env" وضع مفتاح OpenRouter الحقيقي
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxx

# نموذج الـ LLM المستخدم لكل الـ Experts (افتراضي: openai/gpt-4o-mini)
# LLM_MODEL=openai/gpt-4o-mini

# نموذج الـ Embeddings (عبر OpenRouter)
# EMBEDDING_MODEL=openai/text-embedding-3-small

# رابط RSS الخاص بـ Jobs.ps (وظائف قطاع غزة حصراً)
JOBS_RSS_URL=https://www.jobs.ps/rss/jobs/gaza-jobs

# الحد الأقصى للوظائف المعالجة في كل تحليل (افتراضي: 20)
# JOBS_LIMIT=20

